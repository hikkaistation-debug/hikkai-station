---
// 駅名標（駅の看板）風の見出し
// 左右の「となりの駅」は、href を付けると押して移動できます。
// branch を渡すと、その駅から分かれる「支線」の案内を出します。
export type Neighbor = string | { label: string; href?: string };

interface Props {
  title: string;
  kicker?: string; // 上の小さい文字
  sub?: string; // 下の小さい文字（ローマ字など）
  color?: string; // 下の帯の色
  prev?: Neighbor; // 左の「となりの駅」
  next?: Neighbor; // 右の「となりの駅」
  bars?: string[]; // 帯を複数の色に分けるとき（ターミナル駅のトップで使う）
  branch?: { label: string; href: string }; // この駅から分かれる支線の最初の駅
}
const { title, kicker, sub, color, prev, next, bars, branch } = Astro.props;
const norm = (n?: Neighbor) => (n === undefined ? undefined : typeof n === 'string' ? { label: n } : n);
const p = norm(prev);
const n = norm(next);
---
<header class="station-sign">
  <div class="station-sign__body">
    {kicker && <p class="station-sign__kicker">{kicker}</p>}
    <h1 class="station-sign__title">{title}</h1>
    {sub && <p class="station-sign__sub">{sub}</p>}
  </div>
  {bars && bars.length > 0 ? (
    <div class="station-sign__bar station-sign__bar--multi" aria-hidden="true">
      {bars.map((c) => <span style={`background:${c}`}></span>)}
    </div>
  ) : (
    <div class="station-sign__bar" style={color ? `--bar:${color}` : undefined} aria-hidden="true"></div>
  )}
  {(p || n) && (
    <nav class="station-sign__neighbors" aria-label="となりの駅">
      <span class="station-sign__prev">
        {p && (p.href
          ? <a href={p.href} rel="prev"><span aria-hidden="true">← </span><span class="visually-hidden">前の駅：</span>{p.label}</a>
          : <span aria-hidden="true">← {p.label}</span>)}
      </span>
      <span class="station-sign__next">
        {n && (n.href
          ? <a href={n.href} rel="next"><span class="visually-hidden">次の駅：</span>{n.label}<span aria-hidden="true"> →</span></a>
          : <span aria-hidden="true">{n.label} →</span>)}
      </span>
    </nav>
  )}
  {branch && (
    <p class="station-sign__branch">
      <span class="station-sign__branch-label">支線</span>
      <a href={branch.href}><span class="visually-hidden">支線の駅：</span>{branch.label}<span aria-hidden="true"> ↘</span></a>
    </p>
  )}
</header>
