---
// 法令ナビ・通達ナビの「分野」と「キーワード」の絞り込み
// 使い方：一覧の <li> に data-fields="分野1|分野2" と data-text="検索用の文字" を付け、
//         一覧の <ul> に class="navi-list" を付けて、このコンポーネントを上に置く。
// 分野は複数えらべます（えらんだ分野の「どれか」に当てはまるものを表示）。
// 条件はアドレス（?q=…&field=…）に残るので、そのまま共有できます。
import { NAVI_FIELD_GROUPS } from '../data/navi';
import { GLOSSARY } from '../data/glossary';
// 用語さくいんの言葉とよみを関連ワードにする（「がいきぶんだんせい」→「外気分断性」）
const synonyms = GLOSSARY.map((t) => [t.term.replace(/（.*?）/g, ''), t.yomi]);

// ・quick：検索欄の下に並べる「よく探される言葉」。押すとその言葉で探します
// ・sortable：true なら「新しい順／古い順」の切り替えを出す（一覧の <section class="navi-year"> ごと並べ替え）
// ・一覧の中の <button data-pick-field="分野"> を押すと、キーワードを消して、その分野だけにしぼりこみます
// ・キーワードに当たった言葉は、.navi-hl の中で色がつきます
// ・fieldGroups：分野の一覧を差しかえるとき（判例ナビなど）。省略すると法令・通達の共通の分野（navi.ts）
interface Props {
  used: string[]; // 一覧で実際に使われている分野（使われていない分野のボタンは出さない）
  placeholder?: string;
  quick?: string[];
  sortable?: boolean;
  fieldGroups?: readonly { title: string; fields: readonly string[] }[];
}
const { used, placeholder = '例）相続人申告、外気分断性', quick = [], sortable = false, fieldGroups = NAVI_FIELD_GROUPS } = Astro.props;
const groups = fieldGroups.map((g) => ({ title: g.title, fields: g.fields.filter((f) => used.includes(f)) })).filter((g) => g.fields.length);
---
<div class="navi-filter" id="navi-filter" data-synonyms={JSON.stringify(synonyms)}>
  <div class="navi-filter__q">
    <label for="navi-q">キーワード</label>
    <input type="search" id="navi-q" placeholder={placeholder} />
  </div>
  {quick.length > 0 && (
    <div class="navi-quick">
      <span class="navi-quick__label">よく探される言葉：</span>
      <ul>{quick.map((w) => <li><button type="button" data-quick={w}>{w}</button></li>)}</ul>
    </div>
  )}
  <details class="facets" open>
    <summary>分野でしぼりこむ<span id="navi-sel"></span></summary>
    {groups.map((g) => (
      <div class="facets__row">
        <p class="facets__label">{g.title}</p>
        <ul class="facet-chips">
          {g.fields.map((f) => (
            <li><button type="button" class="facet-chip facet-chip--tag" data-field={f} aria-pressed="false">{f}<span class="facet-chip__count"></span></button></li>
          ))}
        </ul>
      </div>
    ))}
    <p class="facets__foot"><button type="button" class="facets__clear" id="navi-clear">しぼりこみを外す</button></p>
  </details>
  <div class="navi-bar">
    <p id="navi-count" aria-live="polite"></p>
    {sortable && (
      <p class="navi-sort">
        <label for="navi-sort">並び順</label>
        <select id="navi-sort">
          <option value="new">新しい順</option>
          <option value="old">古い順</option>
        </select>
      </p>
    )}
  </div>
</div>

<script>
  // 全角・半角、大文字・小文字、カタカナ・ひらがなの違いを気にせず探せるようにする
  const norm = (s: string) => s.normalize('NFKC').toLowerCase().replace(/[ァ-ヶ]/g, (c) => String.fromCharCode(c.charCodeAt(0) - 0x60));
  const items = [...document.querySelectorAll<HTMLElement>('.navi-list > li')];
  const texts = items.map((li) => norm(li.dataset.text ?? ''));
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.navi-filter [data-field]')];
  const q = document.getElementById('navi-q') as HTMLInputElement;
  const count = document.getElementById('navi-count')!;
  const sel = document.getElementById('navi-sel')!;
  const selected = new Set<string>();
  const syn: string[][] = JSON.parse(document.querySelector<HTMLElement>('.navi-filter')!.dataset.synonyms ?? '[]').map((w: string[]) => w.map(norm));
  // 入力した言葉と、その関連ワード（どれかに当たればよい）
  const expand = (w: string) => [...new Set([w, ...syn.filter((ws) => ws.some((x) => x === w || (w.length >= 2 && x.includes(w)))).flat()])];

  const quickBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-quick]')];
  const sortSel = document.getElementById('navi-sort') as HTMLSelectElement | null;

  // キーワードに当たった言葉に色をつける（.navi-hl の中だけ。リンクなどの形はそのまま）
  const hlAreas = [...document.querySelectorAll<HTMLElement>('.navi-list .navi-hl')];
  const hlOrig = hlAreas.map((el) => el.innerHTML);
  function highlight(words: string[]) {
    hlAreas.forEach((el, i) => { el.innerHTML = hlOrig[i]; });
    const ws = words.filter((w) => w.length > 0);
    if (!ws.length) return;
    hlAreas.forEach((el) => {
      if (el.closest('li')?.hidden) return;
      const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
      const nodes: Text[] = [];
      while (walker.nextNode()) nodes.push(walker.currentNode as Text);
      nodes.forEach((node) => {
        const src = node.data;
        // 1文字ずつ正規化して、元の位置との対応表を作る
        let nz = ''; const pos: number[] = [];
        for (let i = 0; i < src.length; i++) { const c = norm(src[i]); nz += c; for (let k = 0; k < c.length; k++) pos.push(i); }
        const marks: [number, number][] = [];
        ws.forEach((w) => {
          let at = nz.indexOf(w);
          while (at >= 0) { marks.push([pos[at], pos[at + w.length - 1] + 1]); at = nz.indexOf(w, at + w.length); }
        });
        if (!marks.length) return;
        marks.sort((a, b) => a[0] - b[0]);
        const merged: [number, number][] = [];
        marks.forEach((m) => { const last = merged[merged.length - 1]; if (last && m[0] <= last[1]) last[1] = Math.max(last[1], m[1]); else merged.push([...m]); });
        const frag = document.createDocumentFragment();
        let cur = 0;
        merged.forEach(([a, b]) => {
          if (a > cur) frag.append(src.slice(cur, a));
          const mk = document.createElement('mark'); mk.textContent = src.slice(a, b); frag.append(mk);
          cur = b;
        });
        if (cur < src.length) frag.append(src.slice(cur));
        node.replaceWith(frag);
      });
    });
  }

  // 並び順（新しい順／古い順）：年の見出しごと、中の並びも入れかえる
  let order = 'new';
  function sortTo(v: string) {
    if (v === order) return;
    const secs = [...document.querySelectorAll<HTMLElement>('.navi-year')];
    const parent = secs[0]?.parentElement;
    if (parent) {
      const anchor = secs[secs.length - 1].nextSibling;
      secs.reverse().forEach((s) => parent.insertBefore(s, anchor));
    }
    document.querySelectorAll<HTMLElement>('.navi-list').forEach((ul) => {
      [...ul.children].reverse().forEach((li) => ul.append(li));
    });
    order = v;
  }

  function apply() {
    const words = norm(q.value).trim().split(/\s+/).filter(Boolean);
    const groups = words.map(expand);
    const byWord = items.map((_, i) => groups.every((alts) => alts.some((w) => texts[i].includes(w))));
    const fieldsOf = (li: HTMLElement) => (li.dataset.fields ?? '').split('|');
    let n = 0;
    items.forEach((li, i) => {
      const okF = selected.size === 0 || fieldsOf(li).some((f) => selected.has(f));
      li.hidden = !(byWord[i] && okF);
      if (!li.hidden) n++;
    });
    // ボタンごとの件数（キーワードに合うもののうち、その分野の件数）
    chips.forEach((c) => {
      const k = items.filter((li, i) => byWord[i] && fieldsOf(li).includes(c.dataset.field!)).length;
      c.querySelector('.facet-chip__count')!.textContent = String(k);
      c.disabled = k === 0 && !selected.has(c.dataset.field!);
    });
    // 法律ごとの見出しは、中身が0件なら隠す
    document.querySelectorAll<HTMLElement>('.navi-list').forEach((ul) => {
      const sec = ul.closest('section');
      if (sec) sec.hidden = !ul.querySelector(':scope > li:not([hidden])');
    });
    highlight(groups.flat());
    count.textContent = `${n}件`;
    sel.textContent = selected.size ? `：${selected.size}件えらび中` : '';
    const p = new URLSearchParams();
    if (q.value.trim()) p.set('q', q.value.trim());
    selected.forEach((f) => p.append('field', f));
    if (sortSel?.value === 'old') p.set('sort', 'old');
    quickBtns.forEach((b) => b.setAttribute('aria-pressed', String(norm(q.value).trim() === norm(b.dataset.quick!))));
    const s = p.toString();
    history.replaceState(null, '', s ? `?${s}` : location.pathname);
  }

  chips.forEach((c) =>
    c.addEventListener('click', () => {
      const f = c.dataset.field!;
      if (selected.has(f)) selected.delete(f); else selected.add(f);
      c.setAttribute('aria-pressed', String(selected.has(f)));
      apply();
    }),
  );
  document.getElementById('navi-clear')!.addEventListener('click', () => {
    selected.clear();
    chips.forEach((c) => c.setAttribute('aria-pressed', 'false'));
    apply();
  });
  q.addEventListener('input', apply);

  // よく探される言葉：押すとその言葉で探す（もう一度押すと外す）
  quickBtns.forEach((b) =>
    b.addEventListener('click', () => {
      q.value = norm(q.value).trim() === norm(b.dataset.quick!) ? '' : b.dataset.quick!;
      apply();
    }),
  );

  // 一覧の中の分野の印：押すと、その分野だけにしぼりこむ
  document.querySelectorAll<HTMLButtonElement>('[data-pick-field]').forEach((b) =>
    b.addEventListener('click', () => {
      selected.clear();
      selected.add(b.dataset.pickField!);
      q.value = ''; // その分野の一覧をまるごと見せる
      chips.forEach((c) => c.setAttribute('aria-pressed', String(selected.has(c.dataset.field!))));
      const det = document.querySelector<HTMLDetailsElement>('.navi-filter details');
      if (det) det.open = true;
      apply();
      document.getElementById('navi-filter')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }),
  );

  sortSel?.addEventListener('change', () => { sortTo(sortSel.value); apply(); });

  const params = new URLSearchParams(location.search);
  if (sortSel && params.get('sort') === 'old') { sortSel.value = 'old'; sortTo('old'); }
  q.value = params.get('q') ?? '';
  params.getAll('field').forEach((f) => selected.add(f));
  chips.forEach((c) => c.setAttribute('aria-pressed', String(selected.has(c.dataset.field!))));
  apply();
</script>
