---
// 駅の施設「通達ナビ」：登記に関する通達を、分野・キーワードで探せる一覧
// データは src/data/tsutatsu.ts
import BaseLayout from '../../layouts/BaseLayout.astro';
import StationSign from '../../components/StationSign.astro';
import { TERMINAL } from '../../data/site';
import NaviFilter from '../../components/NaviFilter.astro';
import DevTsutatsuMark from '../../components/DevTsutatsuMark.astro';
import { sortedTsutatsu, wareki, nenMidashi } from '../../data/tsutatsu';

const list = sortedTsutatsu();
const used = [...new Set(list.flatMap((t) => t.fields))];
// 年ごとにまとめる（新しい順）
const years = [...new Set(list.map((t) => nenMidashi(t.date)))].map((y) => ({ y, items: list.filter((t) => nenMidashi(t.date) === y) }));
const quick = ['筆界特定', '地積測量図', '閲覧', '建物の認定', '相続登記', '住所変更', '過料', '所有不動産記録証明書'];
---
<BaseLayout title="通達ナビ" description="登記に関する法務省の通達を、分野やキーワードで探せるコーナーです。名称・日付・番号と公式の本文へのリンクをまとめています。">
  <StationSign title="通達ナビ" sub="CIRCULARS" prev={TERMINAL} />

  <p>
    登記に関する<strong>通達</strong>を、分野やキーワードで探せるようにまとめています。
    本文は転載せず、公式の資料（法務省など）へのリンクで紹介します。少しずつ増やしていきます。
  </p>

  {import.meta.env.DEV && <DevTsutatsuMark />}

  <NaviFilter used={used} quick={quick} sortable placeholder="例）筆界特定、閲覧、住所変更" />

  <div class="navi-years">
    {years.map(({ y, items }) => (
      <section class="navi-year" aria-label={y}>
        <h2 class="navi-year__h">{y}</h2>
        <ul class="tsutatsu-list navi-list">
          {items.map((t) => (
            <li class="tsutatsu" data-tsutatsu-id={import.meta.env.DEV ? t.id : undefined} data-tsutatsu-title={import.meta.env.DEV ? t.title : undefined} data-fields={t.fields.join('|')} data-text={[t.title, t.number, wareki(t.date), t.date.slice(0, 4), t.summary, ...t.laws, ...t.fields, ...t.keywords].join(' ')}>
              <p class="tsutatsu__meta navi-hl">{wareki(t.date)}付け　{t.number}</p>
              <h3 class="tsutatsu__title navi-hl"><a href={`/tsutatsu/${t.id}/`}>{t.title}</a></h3>
              <p class="tsutatsu__summary navi-hl">{t.summary}</p>
              <p class="tsutatsu__laws navi-hl"><span>関係する法令：</span>{t.laws.join('、')}</p>
              <ul class="tsutatsu__fields">{t.fields.map((f) => <li><button type="button" data-pick-field={f} title={`「${f}」の通達だけを表示`}>{f}</button></li>)}</ul>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <div class="page-body">
    <h2>「通達」とは？</h2>
    <p>
      通達は、国の役所（たとえば法務省）が、法務局などの下の機関に向けて出す<strong>行政内部の指示</strong>です。
      法律そのものではなく、一般の方を直接しばるものではありませんが、登記の実務がどのように行われるかを知る手がかりになります。
    </p>
    <p class="tool__note">
      掲載している説明は、このサイトがまとめたものです。正確な内容は、必ずリンク先の本文でご確認ください。改正されていることもあります。
    </p>
    <p>条文は <a href="/hourei/">法令ナビ</a> で、条文・通達・記事・用語をまとめて探すときは <a href="/search/">さがす</a> をどうぞ。</p>
  </div>

</BaseLayout>
