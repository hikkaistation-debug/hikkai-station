---
import BaseLayout from '../layouts/BaseLayout.astro';
import StationSign from '../components/StationSign.astro';
import { neighbors } from '../data/site';
import ComingSoon from '../components/ComingSoon.astro';
---
<BaseLayout title="通達ナビ（準備中）" description="登記に関する通達・先例を探しやすく整理するコーナーです（準備中）。">
  <StationSign title="通達ナビ" sub="CIRCULARS" {...neighbors('/tsutatsu/')} />
  <ComingSoon what="登記に関する通達・先例を、条文・分野・年で絞り込んで探せるコーナー" />
  <div class="page-body">
    <h2>「通達」とは？</h2>
    <p>
      通達は、国の役所（たとえば法務省）が、法務局などの下の機関に向けて出す<strong>行政内部の指示</strong>です。
      法律そのものではなく、一般の方を直接しばるものではありませんが、登記の実務がどのように行われるかを知る手がかりになります。
    </p>
  </div>
</BaseLayout>
