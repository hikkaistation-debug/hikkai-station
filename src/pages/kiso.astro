---
import BaseLayout from '../layouts/BaseLayout.astro';
import StationSign from '../components/StationSign.astro';
import { TERMINAL } from '../data/site';
import ArticleCard from '../components/ArticleCard.astro';
import ListControls from '../components/ListControls.astro';
import { getPublishedArticles, isKiso, KISO_FIRST } from '../data/articles';

const all = (await getPublishedArticles()).filter(isKiso);
// 最初に読んでほしい記事（筆界の話・土地家屋調査士の話）は、一覧の上に別に出し、下の一覧からは外す
// （下の一覧は「ならび順」で並べ替わるので、その外に置いて、いつも最初に見えるようにする）
const firsts = KISO_FIRST.map((id) => all.find((a) => a.id === id)).filter((a) => a !== undefined);
const first = firsts.length > 0;
const kiso = all.filter((a) => !firsts.includes(a));
---
<BaseLayout title="基礎知識について" description="境界や登記の基本を、はじめての方向けにやさしく解説します。">
  <StationSign kicker="1番のりば｜はじめての方" title="基礎知識について" sub="BASICS" color="#6d28a8" prev={TERMINAL} />

  <p>「筆界ってなに？」「境界とどう違うの？」など、基本の言葉や考え方を、はじめての方向けにやさしく解説します。</p>

  {first && (
    <section class="first-pick" aria-labelledby="first-pick-title">
      <h2 id="first-pick-title">まずはここから</h2>
      <p class="first-pick__lead">土地の境目の話は、「筆界」という言葉と、境目を調べる専門家「土地家屋調査士」を知ると、ぐっとわかりやすくなります。はじめての方は、ここから読んでみてください。</p>
      <ul class="first-pick__list">
        {firsts.map((a) => <ArticleCard article={a} />)}
      </ul>
    </section>
  )}

  {first && kiso.length > 0 && <h2 class="rest-title">ほかの基礎知識</h2>}

  <ListControls />

  {kiso.length > 0 ? (
    <ul class="card-list">
      {kiso.map((a) => <ArticleCard article={a} />)}
    </ul>
  ) : (
    !first && <p class="empty">まだ記事はありません。</p>
  )}
</BaseLayout>

<style>
  .first-pick { margin: 1.5rem 0 0.5rem; padding: 0.9rem 1rem 1rem; border: 2px solid #6d28a8; border-radius: 10px; }
  .first-pick h2 { margin: 0 0 0.3rem; font-size: 1.15rem; color: #6d28a8; }
  .first-pick__lead { margin: 0 0 0.8rem; font-size: 0.95rem; }
  .first-pick__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.9rem; }
  .rest-title { font-size: 1.15rem; }
</style>
