---
import BaseLayout from '../layouts/BaseLayout.astro';
import StationSign from '../components/StationSign.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { SITE, MENU } from '../data/site';
import { LINES } from '../data/lines';
import LineBadge from '../components/LineBadge.astro';
import { getPublishedArticles } from '../data/articles';
import { PLATFORMS } from '../data/platforms';
import { TRAINS, getPublishedStories, storyHref } from '../data/trains';

const articles = await getPublishedArticles();
const latest = articles.slice(0, 6);

// 車内の読み物：列車ごとに、いちばん新しい話
const latestStories = (
  await Promise.all(
    Object.values(TRAINS).map(async (t) => ({ t, s: (await getPublishedStories(t.id)).at(-1) })),
  )
).filter((x): x is { t: (typeof x)['t']; s: NonNullable<(typeof x)['s']> } => Boolean(x.s));

// 読者別の入口「のりば」（色などは src/data/platforms.ts にまとめています）
const platforms = PLATFORMS;
---
<BaseLayout>
  <StationSign kicker="ようこそ｜ターミナル駅" title={SITE.name} sub="HIKKAI STATION" bars={platforms.map((p) => p.color)} />

  <p>{SITE.description}</p>

  <section aria-labelledby="platforms-heading">
    <h2 id="platforms-heading">のりば ― あなたに合う入口から</h2>
    <div class="platforms">
      {platforms.map((p) => (
        <a class="platform" href={p.href} style={`--pc:${p.color}`}>
          <span class="platform__head">
            <span class="platform__num" aria-hidden="true">{p.num}</span>
            <span>
              <span class="platform__label">{p.num}番のりば｜{p.who}</span>
              <span class="platform__title">{p.title}</span>
            </span>
          </span>
          <span class="platform__desc">{p.desc}</span>
          <span class="platform__go" aria-hidden="true">このホームへ →</span>
        </a>
      ))}
    </div>
  </section>

  <section aria-labelledby="search-heading">
    <h2 id="search-heading">サイト内をさがす</h2>
    <form class="search-box" action="/search/" method="get" role="search">
      <label for="top-q" class="visually-hidden">キーワード</label>
      <input id="top-q" name="q" type="search" placeholder="例：相続登記、筆界特定" />
      <button type="submit">さがす</button>
    </form>
  </section>

  <section aria-labelledby="latest-heading">
    <h2 id="latest-heading">新着記事</h2>
    {latest.length > 0 ? (
      <ul class="card-list">
        {latest.map((a) => <ArticleCard article={a} />)}
      </ul>
    ) : (
      <p class="empty">まだ記事はありません。</p>
    )}
  </section>

  {latestStories.length > 0 && (
    <section aria-labelledby="stories-heading">
      <h2 id="stories-heading">車内の読み物 ― 物語で知る筆界</h2>
      <p>筆界や土地家屋調査士の仕事を、楽しく知りながら読める小説です。</p>
      <ul class="story-latest">
        {latestStories.map(({ t, s }) => (
          <li style={`--tc:${t.color}`}>
            <a href={storyHref(s)}>
              <span class="train__kind">{t.kind}</span>
              <span>
                <span class="story-latest__train">{t.title}</span>
                <span class="story-latest__title">第{s.data.no}話　{s.data.title}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p><a href="/yomimono/">車内の読み物の一覧へ →</a></p>
    </section>
  )}

  <section aria-labelledby="map-heading">
    <h2 id="map-heading">サイトの案内図</h2>
    <p>筆界ステーションは、すべての路線が集まるターミナル駅です。</p>
    <div class="site-map">
      {MENU.map((g) => (
        <section class="site-map__group" aria-labelledby={`map-${g.id}`}>
          <h3 id={`map-${g.id}`}>{g.title}</h3>
          <ol class="route-map">
            {g.items.map((s) => (
              <li class={s.ready ? '' : 'is-soon'}>
                {s.ready ? (
                  <a href={s.href}>
                    {s.num && <span class="nav-num" style={`--pc:${s.color}`} aria-hidden="true">{s.num}</span>}
                    {s.label}
                  </a>
                ) : (
                  <span class="stop">{s.label}<small>準備中です</small></span>
                )}
              </li>
            ))}
          </ol>
        </section>
      ))}
      <section class="site-map__group" aria-labelledby="map-lines">
        <h3 id="map-lines">路線</h3>
        <ul class="site-map__lines">
          {LINES.map((l) => <li><LineBadge id={l.id} link /></li>)}
        </ul>
      </section>
    </div>
  </section>
</BaseLayout>
