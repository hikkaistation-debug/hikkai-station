---
// 記事ページ
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StationSign from '../../components/StationSign.astro';
import LineBadge from '../../components/LineBadge.astro';
import LevelBadge from '../../components/LevelBadge.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import { getLine } from '../../data/lines';
import { tagHref } from '../../data/tags';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPublishedArticles, buildTracks, formatDate, isoDate, isKiso, type Article } from '../../data/articles';

export async function getStaticPaths() {
  const articles = await getPublishedArticles(); // 新しい順
  const tracks = buildTracks(articles);
  return articles.map((article) => {
    // となりの駅
    //   本線の記事：左＝1つ新しい記事（いちばん新しい記事なら路線のページ）、右＝1つ古い記事（いちばん古い記事は終点）
    //   支線の記事：左＝支線の1つ前（いちばん最初なら分かれ元の記事）、右＝支線の次
    let toward: Article | undefined; // 左（ターミナル側）
    let away: Article | undefined; // 右（先へ進む）
    const parent = tracks.parentOf(article);
    if (parent) {
      const branch = tracks.branchOf(parent.id);
      const i = branch.findIndex((a) => a.id === article.id);
      toward = i === 0 ? parent : branch[i - 1];
      away = branch[i + 1];
    } else {
      const main = tracks.main(article.data.category);
      const i = main.findIndex((a) => a.id === article.id);
      toward = main[i - 1];
      away = main[i + 1];
    }
    const branchStart = tracks.branchOf(article.id)[0]; // この記事から分かれる支線の最初の駅
    // 関連する記事：同じタグが多い順（同じ路線なら少しだけ優先）。上位3件
    const myTags = new Set(article.data.tags as string[]);
    const related = articles
      .filter((a) => a.id !== article.id)
      .map((a) => ({
        a,
        score: (a.data.tags as string[]).filter((x) => myTags.has(x)).length + (a.data.category === article.data.category ? 0.5 : 0),
      }))
      .filter((r) => r.score >= 1)
      .sort((x, y) => y.score - x.score || y.a.data.pubDate.getTime() - x.a.data.pubDate.getTime())
      .slice(0, 3)
      .map((r) => r.a);
    return { params: { id: article.id }, props: { article, toward, away, branchStart, parent, related } };
  });
}

interface Props {
  article: Article;
  toward?: Article;
  away?: Article;
  branchStart?: Article;
  parent?: Article;
  related: Article[];
}
const { article, toward, away, branchStart, parent, related } = Astro.props;
const toNb = (a?: Article) => (a ? { label: a.data.title, href: `/articles/${a.id}/` } : undefined);
const { data } = article;
const line = getLine(data.category);
const { Content } = await render(article);
const hasBody = Boolean(article.body?.trim());
const back = isKiso(article) ? { href: '/kiso/', label: '基礎知識' } : { href: '/news/', label: 'ニュース' };
const isKiki = data.category === 'kiki' && data.product;
// 関連する駅：この記事の路線＋relatedLines（重複なし）
const relatedLines = [...new Set([data.category, ...data.relatedLines])];
---
<BaseLayout title={data.title} description={data.summary} type="article">
  <StationSign
    kicker={parent ? `${line.code}線 ${line.short}｜支線` : `${line.code}線 ${line.short}`}
    title={data.title}
    color={line.color}
    prev={toNb(toward) ?? { label: line.name, href: `/category/${line.id}/` }}
    next={toNb(away)}
    branch={toNb(branchStart)}
  />

  {data.sample && (
    <aside class="notice notice--sample">
      <p class="notice__title">これはサンプル記事です</p>
      <p>表示の確認用に作った記事です。公開する前に、運営者が出典の原文と照らして内容を確認してください。</p>
    </aside>
  )}

  <div class="badges">
    <LineBadge id={data.category} link />
    <LevelBadge level={data.level} />
  </div>
  <p class="article-meta">
    公開日：<time datetime={isoDate(data.pubDate)}>{formatDate(data.pubDate)}</time>
    {data.updatedDate && (
      <>／更新日：<time datetime={isoDate(data.updatedDate)}>{formatDate(data.updatedDate)}</time></>
    )}
  </p>

  {isKiki && data.product && (
    <section class="article-box product-box" aria-labelledby="product-h">
      <h2 id="product-h">測量ツールの情報</h2>
      <dl class="product-spec">
        <div><dt>名前</dt><dd>{data.product.name}</dd></div>
        <div><dt>種類</dt><dd>{data.product.kind}</dd></div>
        <div><dt>用途</dt><dd>{data.product.use}</dd></div>
        <div><dt>最終確認日</dt><dd><time datetime={isoDate(data.product.checkedDate)}>{formatDate(data.product.checkedDate)}</time></dd></div>
      </dl>
      <p class="product-note">価格・仕様・対応機種などは変わることがあります。必ず公式の情報で確認してください。このサイトは、特定の製品をおすすめするものではありません。</p>
    </section>
  )}

  <section class="article-box" aria-labelledby="summary-h">
    <h2 id="summary-h">要約</h2>
    <p>{data.summary}</p>
  </section>

  <p class="read-original">
    <a class="cta__button" href={data.sourceUrl} rel="noopener" target="_blank">
      元の記事を読む<span class="visually-hidden">（{data.sourceName}・新しいタブで開きます）</span> ↗
    </a>
    <small>出典：{data.sourceName}</small>
  </p>

  {hasBody && (
    <div class="prose">
      <Content />
    </div>
  )}

  <section class="article-box article-box--comment" aria-labelledby="comment-h">
    <h2 id="comment-h">ひとこと</h2>
    <p>{data.comment}</p>
  </section>

  <section class="article-box" aria-labelledby="source-h">
    <h2 id="source-h">{isKiki ? '公式資料へのリンク' : '出典（原文）'}</h2>
    <ul class="source-list">
      <li>
        {data.sourceName}<br />
        <a class="source-link" href={data.sourceUrl} rel="noopener" target="_blank">{data.sourceUrl}<span class="visually-hidden">（新しいタブで開きます）</span></a>
      </li>
      {isKiki && data.product && data.product.officialUrl !== data.sourceUrl && (
        <li>
          公式サイト<br />
          <a class="source-link" href={data.product.officialUrl} rel="noopener" target="_blank">{data.product.officialUrl}<span class="visually-hidden">（新しいタブで開きます）</span></a>
        </li>
      )}
      {isKiki && data.product?.makerDocUrl && (
        <li>
          メーカー資料<br />
          <a class="source-link" href={data.product.makerDocUrl} rel="noopener" target="_blank">{data.product.makerDocUrl}<span class="visually-hidden">（新しいタブで開きます）</span></a>
        </li>
      )}
    </ul>
  </section>

  {data.tags.length > 0 && (
    <ul class="tags" aria-label="タグ">
      {data.tags.map((t) => <li><a href={tagHref(t)}>#{t}</a></li>)}
    </ul>
  )}

  {related.length > 0 && (
    <section aria-labelledby="related-h">
      <h2 id="related-h">関連する記事</h2>
      <ul class="card-list">
        {related.map((a) => <ArticleCard article={a} />)}
      </ul>
    </section>
  )}

  <section class="article-box" aria-labelledby="stations-h">
    <h2 id="stations-h">関連する駅</h2>
    <div class="badges">
      {relatedLines.map((id) => <LineBadge id={id} link />)}
    </div>
  </section>

  <Disclaimer />

  <p><a href={back.href}>← {back.label}の一覧へ</a></p>
</BaseLayout>
