---
// 発車標（ニュース）のページ … 新着ニュースを見出し・出典・日付だけで並べる（30日たったものは自動で消える）
// ニュースの出し方は src/data/news.ts を見てください。
import BaseLayout from '../layouts/BaseLayout.astro';
import StationSign from '../components/StationSign.astro';
import NewsBoard from '../components/NewsBoard.astro';
import { TERMINAL } from '../data/site';
import { getNews, NEWS_DAYS } from '../data/news';

const items = await getNews();
---
<BaseLayout title="ニュース（発車標）" description="筆界・境界・登記・土地家屋調査士に関する新着ニュースを、出典へのリンクで紹介しています。">
  <StationSign kicker="駅の施設" title="発車標" sub="NEWS" color="#1f2a44" prev={TERMINAL} />

  <p>筆界・境界・登記・土地家屋調査士に関する新しいニュースを、見出しと出典だけで紹介しています。内容は、それぞれのリンク先（元の記事）でご確認ください。{NEWS_DAYS}日たったニュースは、ここから消えます。</p>

  <NewsBoard items={items} title="新着ニュース" more={false} />

  <aside class="notice">
    <p class="notice__title">見出しの左の印について</p>
    <p>ニュースが関係する路線（カテゴリ）の色と記号です。くわしく解説した記事は、<a href="/jitsumu/">実務（3番のりば）</a>や<a href="/rosenzu/">路線図</a>からさがせます。</p>
  </aside>

  <p class="moved-note">※ 以前このアドレスにあった「実務」のページは、<a href="/jitsumu/">/jitsumu/</a> に移りました。</p>
</BaseLayout>

<style>
  .moved-note { font-size: 0.9rem; color: var(--ink-soft); }
</style>
